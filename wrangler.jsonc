// Cloudflare deploy: Blackout is a static site. There is no Worker script, so nothing runs on the
// server; Cloudflare only serves the files in dist/ and applies the headers in dist/_headers
// (generated by `pnpm build`, including the Content-Security-Policy).
{
  "name": "blackout-redact",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  }
}
