{
  "name": "blackout",
  "version": "0.1.2",
  "private": true,
  "description": "Redact PDFs and images entirely in your browser. Nothing is uploaded.",
  "license": "Apache-2.0",
  "author": "Mochamad Daffa",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
